{
  "rules": {
    ".read": false,
    ".write": false,
    "gone": {
      ".read": true,
      "$cafe": {
        ".validate": "$cafe.matches(/^[0-9a-z]+$/) && $cafe.length <= 12",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['t'])",
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "seats": {
      ".read": true,
      "$cafe": {
        ".validate": "$cafe.matches(/^[0-9a-z]+$/) && $cafe.length <= 12",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['o', 'c', 't'])",
          "o": {
            ".validate": "newData.val() === 1 || newData.val() === -1"
          },
          "c": {
            ".validate": "newData.isString() && newData.val().length <= 3 && newData.val().matches(/^[nws]*$/)"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "v2": {
      "tags": {
        ".read": true,
        "$cafe": {
          ".validate": "$cafe.matches(/^[0-9a-z]+$/) && $cafe.length <= 12",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
            ".validate": "newData.hasChildren(['t'])",
            "h": {
              ".validate": "newData.val() === 1"
            },
            "p": {
              ".validate": "newData.val() === 1"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "want": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          "$cafe": {
            ".validate": "$cafe.matches(/^[0-9a-z]+$/) && $cafe.length <= 12 && newData.val() === true"
          }
        }
      },
      "gone": {
        ".read": true,
        "$cafe": {
          ".validate": "$cafe.matches(/^[0-9a-z]+$/) && $cafe.length <= 12",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
            ".validate": "newData.hasChildren(['t'])",
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "gonedec": {
        ".read": true,
        "$cafe": {
          ".write": "auth != null && auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1'",
          ".validate": "$cafe.matches(/^[0-9a-z]+$/) && $cafe.length <= 12 && newData.hasChildren(['d', 't'])",
          "d": {
            ".validate": "newData.val() === 0 || newData.val() === 1"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "seats": {
        ".read": true,
        "$cafe": {
          ".validate": "$cafe.matches(/^[0-9a-z]+$/) && $cafe.length <= 12",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
            ".validate": "newData.hasChildren(['o', 'c', 't'])",
            "o": {
              ".validate": "newData.val() === 1 || newData.val() === -1"
            },
            "c": {
              ".validate": "newData.isString() && newData.val().length <= 3 && newData.val().matches(/^[nws]*$/)"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "feedback": {
        "$id": {
          ".write": "!data.exists() || (auth != null && !newData.exists() && data.child('u').val() === auth.uid)",
          ".validate": "newData.hasChildren(['k', 'm', 't'])",
          "k": {
            ".validate": "newData.isString() && newData.val().matches(/^(bug|idea|etc|report)$/)"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1500"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "u": {
            ".validate": "auth != null && newData.val() === auth.uid"
          },
          "to": {
            ".validate": "newData.isString() && newData.val().length <= 128 && newData.parent().child('k').val() === 'report'"
          },
          "$other": {
            ".validate": false
          }
        },
        ".read": "auth != null && (auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1' || (query.orderByChild === 'u' && query.equalTo === auth.uid))",
        ".indexOn": [
          "u"
        ]
      },
      "fbreply": {
        ".read": "auth != null && auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1'",
        "$id": {
          ".read": true,
          ".write": "auth != null && (auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1' || (!newData.exists() && root.child('v2/feedback/' + $id + '/u').val() === auth.uid))",
          ".validate": "newData.hasChildren(['m', 't']) && root.child('v2/feedback/' + $id).exists()",
          "m": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1500"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rank": {
        ".read": true,
        ".indexOn": [
          "x"
        ],
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous' && (!newData.exists() || !root.child('v2/ban/' + $uid).exists())) || auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1')",
          ".validate": "newData.hasChildren(['n', 'x', 't']) && (auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1' || !data.exists() || newData.child('n').val() === data.child('n').val() || (newData.child('nt').val() === now && (!data.child('nt').exists() || now - data.child('nt').val() >= 15552000000)))",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && (!data.exists() || newData.val() <= data.val() + 1000000) && (data.exists() || newData.val() <= 1000000)"
          },
          "v": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"
          },
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 25000"
          },
          "o": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"
          },
          "r": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "nt": {
            ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "pub": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous') || auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1')",
          ".validate": "newData.hasChildren(['n', 'log', 't'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "log": {
            "$i": {
              ".validate": "newData.hasChildren(['a', 'r'])",
              "d": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "a": {
                ".validate": "newData.isNumber()"
              },
              "r": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "c": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "ban": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1')",
          ".write": "auth != null && auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1'",
          ".validate": "newData.hasChildren(['t'])",
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "nickreset": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1')",
          ".write": "auth != null && (auth.uid === 'YJZkK7gP9xYP2fBjh2KWnJHDOsl1' || (auth.uid === $uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['n', 't'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "xp": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.hasChildren(['xp']) && newData.child('xp').isNumber() && newData.child('xp').val() >= 0"
        }
      }
    }
  }
}
